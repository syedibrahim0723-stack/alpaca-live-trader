# All keys can also be entered on the Sources page (stored encrypted in data/).
# Values here are used only when the matching key was never entered in the UI.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ANTHROPIC_API_KEY=

# Optional: fixed encryption key for stored API keys (Fernet, urlsafe base64 32 bytes).
# If unset, one is generated into data/.master.key on first run.
# NEWS_RADAR_SECRET=
